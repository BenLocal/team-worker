[Unit]
Description=OpenBao secrets server (enabled by default; TEAM_WORKER_OPENBAO=0 disables it)

[Service]
Type=exec
User=node
Group=node
EnvironmentFile=/run/team-worker/agent.env
ExecCondition=/bin/sh -c 'test "$${TEAM_WORKER_OPENBAO:-0}" = 1'
ExecStartPre=/usr/bin/mkdir -p -m 700 /home/node/.openbao/data
# Raft data from a deployment with another node ID would leave this node a
# standby that never serves secrets; recover it as this node once.
ExecStartPre=/usr/local/bin/team-worker-ops openbao-raft
ExecStart=/usr/local/bin/bao server -config=/etc/openbao/openbao.hcl
Restart=always
RestartSec=3
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
